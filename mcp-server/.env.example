# FXServer RCON (UDP, same port as the game server). Must match `set rcon_password` in server.cfg.
FXSERVER_HOST=127.0.0.1
FXSERVER_PORT=30120
FXSERVER_RCON_PASSWORD=

# Must match `set ai_bridge_token` in server.cfg. Resource HTTP handlers live at /<resourceName>/.
AI_BRIDGE_TOKEN=
AI_BRIDGE_ENDPOINT=http://127.0.0.1:30120/ai_dev_bridge

# FiveM client CEF DevTools (open by default while the game runs, localhost only)
FIVEM_CEF_PORT=13172

# Optional: override the FiveM client log folder (default %LOCALAPPDATA%\FiveM\FiveM.app\logs)
# FIVEM_LOG_DIR=
